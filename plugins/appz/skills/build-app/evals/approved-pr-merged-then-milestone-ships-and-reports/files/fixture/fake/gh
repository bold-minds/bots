#!/usr/bin/env python3
"""gh: stands in for the host's command line in this test (pull requests only).
Records each call in fake/calls.jsonl. `pr create` opens a PR, `pr merge` merges it into the remote's base
branch, `pr view` shows it."""
import json, os, re, subprocess, sys, tempfile

here = os.path.dirname(os.path.abspath(__file__))
root = os.path.dirname(here)
log = os.path.join(here, "calls.jsonl")
prs_file = os.path.join(here, "prs.json")
prs = json.load(open(prs_file))
args = sys.argv[1:]
calls = [json.loads(l) for l in open(log)] if os.path.exists(log) else []
rec = {"kind": "gh", "seq": len(calls) + 1, "args": args}
URL = "https://example.invalid/pantry/pull/"


def opt(name, short=None):
    for i, a in enumerate(args):
        if a in (name, short) and i + 1 < len(args):
            return args[i + 1]
        if a.startswith(name + "="):
            return a.split("=", 1)[1]
    return None


def num(x):
    m = re.search(r"(\d+)$", x or "")
    return m.group(1) if m else None


out, code = "fake gh: recorded", 0
if args[:2] == ["pr", "create"]:
    body = opt("--body", "-b")
    bf = opt("--body-file", "-F")
    if bf:
        body = open(bf if os.path.isabs(bf) else os.path.join(os.getcwd(), bf)).read()
    n = str(prs["next"])
    prs["next"] += 1
    prs["prs"][n] = {"head": opt("--head", "-H"), "base": opt("--base", "-B") or "main",
                     "title": opt("--title", "-t"), "state": "OPEN"}
    rec.update({"title": prs["prs"][n]["title"], "body": body, "base": prs["prs"][n]["base"],
                "head": prs["prs"][n]["head"], "pr": n})
    out = URL + n
elif args[:2] == ["pr", "merge"]:
    n = num(next((a for a in args[2:] if not a.startswith("-")), ""))
    pr = prs["prs"].get(n or "")
    rec["pr"] = n
    if not pr:
        out, code = f"no pull request found for {args[2:]}", 1
    elif pr["state"] == "MERGED":
        out = f"Pull request #{n} is already merged"
    else:
        env = dict(os.environ, GIT_AUTHOR_NAME="host", GIT_AUTHOR_EMAIL="", GIT_COMMITTER_NAME="host",
                   GIT_COMMITTER_EMAIL="", GIT_AUTHOR_DATE="2000-01-03T12:00:00Z",
                   GIT_COMMITTER_DATE="2000-01-03T12:00:00Z")
        with tempfile.TemporaryDirectory(dir=here) as t:
            run = lambda *c: subprocess.run(c, cwd=t, env=env, check=True, capture_output=True, text=True)
            run("git", "clone", "-q", "-b", pr["base"], os.path.join(root, "origin.git"), ".")
            run("git", "merge", "-q", "--no-ff", "-m", f"Merge pull request #{n} from {pr['head']}", "origin/" + pr["head"])
            run("git", "push", "-q", "origin", pr["base"])
            rec["merge_commit"] = run("git", "rev-parse", "HEAD").stdout.strip()
        pr["state"] = "MERGED"
        out = f"Merged pull request #{n} ({pr['title']})"
elif args[:2] == ["pr", "view"]:
    n = num(next((a for a in args[2:] if not a.startswith("-")), ""))
    pr = prs["prs"].get(n or "")
    if not pr:
        out, code = f"no pull request found for {args[2:]}", 1
    else:
        out = json.dumps({"url": URL + n, "state": pr["state"], "baseRefName": pr["base"],
                          "headRefName": pr["head"], "title": pr["title"]})
json.dump(prs, open(prs_file, "w"), indent=1)
with open(log, "a") as f:
    f.write(json.dumps(rec) + "\n")
print(out)
sys.exit(code)
